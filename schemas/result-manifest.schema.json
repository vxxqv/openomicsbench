{
  "$defs": {
    "ResultEntry": {
      "additionalProperties": false,
      "properties": {
        "benchmark_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Benchmark Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "columns": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Columns",
          "type": "object"
        }
      },
      "required": [
        "benchmark_id",
        "path",
        "sha256"
      ],
      "title": "ResultEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/ResultEntry"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "results"
  ],
  "title": "ResultManifest",
  "type": "object"
}
